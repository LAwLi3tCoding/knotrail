{
  "name": "knotrail",
  "version": "0.1.0",
  "private": true,
  "description": "A local pi-powered coding workbench with visible plans and verifiable task history",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "author": "LAwLi3tCoding",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac dir",
    "smoke:live": "node --import tsx scripts/live-smoke.ts",
    "test:desktop": "node tests/desktop-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typebox": "^1.3.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "dev.knotrail.desktop",
    "productName": "Knotrail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "npmRebuild": true,
    "asar": false
  }
}
